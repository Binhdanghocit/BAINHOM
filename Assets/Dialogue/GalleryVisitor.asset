  m_Script: {fileID: 11500000, guid: d4af0a2058527afbf3071e674c420fe0, type: 3}
  m_Name: GalleryVisitor
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueData
  opening: "Chào bạn! Mình đang ngắm tranh, càng nhìn càng thấy nhiều điều thú vị."
  options:
  - question: "Bạn thích bức nào nhất?"
    answer: "Mình thích bức Đám cưới chuột nhất. Cảnh đoàn chuột nối nhau làm mình cứ muốn nhìn thêm."
    action: 0
  - question: "Điều gì khiến bạn chú ý?"
    answer: "Mình thích màu sắc và những chi tiết nhỏ trong tranh. Có những nét thoạt nhìn rất đơn giản mà lại khiến mình nhớ lâu."
    action: 0
  - question: "Chúc bạn tham quan vui."
    answer: "Cảm ơn bạn, chúc bạn cũng tìm được một bức tranh mình yêu thích!"
    action: 1
  exitLabel: "Đóng hội thoại"
