  m_Script: {fileID: 11500000, guid: d4af0a2058527afbf3071e674c420fe0, type: 3}
  m_Name: GalleryVisitor_Floor1
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueData
  opening: "Bạn cũng đang xem bức Lợn đàn à? Mình thấy cảnh lợn mẹ và đàn con thật gần gũi."
  options:
  - question: "Bạn đang xem điều gì?"
    answer: "Mình đang nhìn đàn lợn con quây quần quanh mẹ. Cảnh ấy khiến mình nghĩ đến một gia đình ấm áp."
    action: 0
  - question: "Bạn thích chi tiết nào?"
    answer: "Mình thích những xoáy âm dương trên mình lợn. Chi tiết ấy làm bức tranh nổi bật và khiến mình muốn ngắm kỹ hơn."
    action: 0
  - question: "Tôi cũng muốn xem kỹ hơn."
    answer: "Ừ, mình cũng muốn nán lại ngắm thêm một lúc. Chúc bạn tìm thấy chi tiết mình thích!"
    action: 1
  exitLabel: "Đóng hội thoại"
