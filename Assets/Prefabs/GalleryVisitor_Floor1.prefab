  m_Script: {fileID: 11500000, guid: da28c2adcd7175d4fb8a8b2faa355a2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcName: "Kh\xE1ch xem tranh (T\u1EA7ng 1)"
  dialogueData: {fileID: 11400000, guid: 8188e13f50092cddd6d2b605b602fafa, type: 2}
  dialogueLines:
  - "B\u1EE9c tranh '\u0110\xE0n l\u1EE3n \xE2m d\u01B0\u01A1ng' n\xE0y s\u1ED1ng
    \u0111\u1ED9ng th\u1EADt! M\u1ED7i ch\xFA l\u1EE3n con \u0111\u1EC1u c\xF3 v\xF2ng
    xo\xE1y \xE2m d\u01B0\u01A1ng tr\xEAn m\xECnh bi\u1EC3u tr\u01B0ng cho s\u1EF1
    sinh s\xF4i n\u1EA3y n\u1EDF."
  - "M\xE0u s\u1EAFc d\xE2n gian \u0110\xF4ng H\u1ED3 tr\xF4ng m\u1ED9c m\u1EA1c
    m\xE0 \u1EA5m c\xFAng, th\u1EC3 hi\u1EC7n \u01B0\u1EDBc nguy\u1EC7n \u1EA5m no,
    sung t\xFAc c\u1EE7a ng\u01B0\u1EDDi n\xF4ng d\xE2n x\u01B0a."
  - "B\u1EA1n nh\u1EDB gh\xE9 th\u0103m c\u1EA3 c\xE1c b\u1EE9c tranh kh\xE1c \u1EDF
    t\u1EA7ng 1 v\xE0 l\xEAn t\u1EA7ng 2 ng\u1EAFm b\u1ED9 tranh l\u1ECBch s\u1EED
    n\u1EEFa nh\xE9!"
  interactionCollider: {fileID: 5468447662025196032}
  workshopTrigger: {fileID: 0}
