  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da28c2adcd7175d4fb8a8b2faa355a2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcName: "Kh\xE1ch xem tranh (T\u1EA7ng 2)"
  dialogueData: {fileID: 11400000, guid: 6548dcfc343fcdce0524ce4795576431, type: 2}
  dialogueLines:
  - "T\u1EA7ng 2 tr\u01B0ng b\xE0y r\u1EA5t nhi\u1EC1u tranh \u0111\u1EC1 t\xE0i
    l\u1ECBch s\u1EED v\xE0 v\u0103n h\xF3a d\xE2n gian \u0111\u1EB7c s\u1EAFc c\u1EE7a
    d\xE2n t\u1ED9c ta!"
  - "B\u1EE9c tranh 'Hai B\xE0 Tr\u01B0ng c\u01B0\u1EE1i voi' \u0111\xE1nh \u0111u\u1ED5i
    gi\u1EB7c \u0110\xF4ng H\xE1n kh\xED th\u1EBF th\u1EADt h\xE0o h\xF9ng, t\u1EEBng
    \u0111\u01B0\u1EDDng n\xE9t \u0111\u1EC1u r\u1EA5t d\u1EE9t kho\xE1t v\xE0 uy
    phong."
  - "Kh\xF4ng gian tr\xEAn n\xE0y y\xEAn t\u0129nh v\xE0 tho\xE1ng \u0111\xE3ng,
    ng\u1EAFm nh\xECn c\xE1c b\u1ED9 tranh t\u1EE9 b\xECnh nh\u01B0 B\xE1t Ti\xEAn,
    Th\u1EA1ch Sanh c\u1EA3m gi\xE1c th\u01B0 th\xE1i v\xF4 c\xF9ng."
  interactionCollider: {fileID: 6491165329248570882}
  workshopTrigger: {fileID: 0}
