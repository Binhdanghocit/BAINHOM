--- !u!114 &932679597
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 720907178}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "\u0110\u1EA4U V\u1EACT"
  paintingDescription: "B\u1EE9c tranh t\xE1i hi\u1EC7n kh\xF4ng kh\xED s\xF4i n\u1ED5i,
    h\xE0o h\xF9ng c\u1EE7a s\u1EDBi v\u1EADt \u0111\u1EA7u xu\xE2n n\u01A1i s\xE2n
    \u0111\xECnh l\xE0ng Vi\u1EC7t c\u1ED5 truy\u1EC1n. \u1EDE trung t\xE2m, hai
    \u0111\xF4 v\u1EADt v\u1EA1m v\u1EE1 m\xECnh tr\u1EA7n \u0111\xF3ng kh\u1ED1
    \u0111ang gh\xECm mi\u1EBFng, so t\xE0i gi\u1EB1ng co quy\u1EBFt li\u1EC7t trong
    th\u1EBF \u0111\u1EE9ng v\u1EEFng nh\u01B0 b\xE0n th\u1EA1ch; xung quanh l\xE0
    d\xE2n l\xE0ng n\xE1o n\u1EE9c v\xE2y k\xEDn reo h\xF2 theo t\u1EEBng nh\u1ECBp
    tr\u1ED1ng th\xFAc gi\u1EE5c gi\xE3. T\xE1c ph\u1EA9m ng\u1EE3i ca tinh th\u1EA7n
    th\u01B0\u1EE3ng v\xF5 ki\xEAn c\u01B0\u1EDDng, s\u1EE9c kh\u1ECFe c\u01B0\u1EDDng
    tr\xE1ng v\xE0 s\u1EF1 kh\xF4n kh\xE9o c\u1EE7a trai tr\xE1ng n\xF4ng th\xF4n,
    \u0111\u1ED3ng th\u1EDDi g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc \u0111\u1EA7u n\u0103m
    cho m\u01B0a thu\u1EADn gi\xF3 h\xF2a, x\xF3m l\xE0ng kh\u1ECFe m\u1EA1nh v\xE0
    tr\xE0n \u0111\u1EA7y sinh kh\xED."
  paintingSprite: {fileID: 21300000, guid: fc2fcc729bf3d3c488f334dcb80fec78, type: 3}
