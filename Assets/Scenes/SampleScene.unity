  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "T\u1EEA H\u1EA2I NGH\xCANH TH\xDAY KI\u1EC0U"
  paintingDescription: "T\xE1c ph\u1EA9m l\u1EA5y c\u1EA3m h\u1EE9ng t\u1EEB ki\u1EC7t
    t\xE1c \"Truy\u1EC7n Ki\u1EC1u\" c\u1EE7a \u0110\u1EA1i thi h\xE0o Nguy\u1EC5n
    Du, v\u1EDBi d\xF2ng l\u1EA1c kho\u1EA3n ch\u1EEF H\xE1n ghi r\xF5 \"T\u1EEB
    H\u1EA3i ngh\xEAnh Th\xFAy Ki\u1EC1u\". B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh
    t\u01B0\u1EE3ng ng\u01B0\u1EDDi anh h\xF9ng T\u1EEB H\u1EA3i uy d\u0169ng tr\xEAn
    l\u01B0ng tu\u1EA5n m\xE3, c\u1EDD l\u1ECDng trang nghi\xEAm ra t\u1EADn b\u1EBFn
    th\xE0nh \u0111\xF3n Th\xFAy Ki\u1EC1u b\u01B0\u1EDBc l\xEAn t\u1EEB thuy\u1EC1n
    hoa. T\xE1c ph\u1EA9m t\xF4n vinh m\u1ED1i t\xECnh tri k\u1EF7 s\xE2u s\u1EAFc,
    s\u1EF1 tr\xE2n tr\u1ECDng nh\xE2n ph\u1EA9m ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF
    t\xE0i s\u1EAFc v\xE0 kh\xE1t v\u1ECDng c\xF4ng l\xFD, t\u1EF1 do, ph\xE1 v\u1EE1
    xi\u1EC1ng x\xEDch phong ki\u1EBFn c\u1EE7a ng\u01B0\u1EDDi b\xECnh d\xE2n x\u01B0a."
  paintingSprite: {fileID: 21300000, guid: 430880021399d764195eb45259ba8742, type: 3}
