  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "R\u01AF\u1EDAC TR\u1ED0NG"
  paintingDescription: "B\u1EE9c tranh mi\xEAu t\u1EA3 \u0111o\xE0n \u0111\u1ED3ng
    t\u1EED b\u1EE5 b\u1EABm c\u1EDFi tr\u1EA7n \u0111ang ki\u1EC7u chi\u1EBFc tr\u1ED1ng
    l\u1EDBn d\u01B0\u1EDBi t\xE1n l\u1ECDng hoa, tay vung qu\u1EA1t m\xFAa may t\u01B0ng
    b\u1EEBng theo nh\u1ECBp r\u01B0\u1EDBc h\u1ED9i l\xE0ng. Ti\u1EBFng tr\u1ED1ng
    h\u1ED9i d\xE2n gian bi\u1EC3u tr\u01B0ng cho ti\u1EBFng s\u1EA5m \u0111\u1EA7u
    xu\xE2n \u0111\xE1nh th\u1EE9c v\u1EA1n v\u1EADt sinh s\xF4i n\u1EA3y n\u1EDF,
    th\u1EC3 hi\u1EC7n ni\u1EC1m vui thu\u1EA7n ph\xE1c, l\u1EA1c quan v\xE0 tr\xE0n
    ng\u1EADp sinh kh\xED c\u1EE7a c\u01B0 d\xE2n n\xF4ng nghi\u1EC7p l\xFAa n\u01B0\u1EDBc."
