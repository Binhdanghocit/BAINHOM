  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "TH\u1EA6Y \u0110\u1ED2 C\xD3C"
  paintingDescription: "T\xE1c ph\u1EA9m tr\xE0o ph\xFAng kinh \u0111i\u1EC3n v\u1EDBi
    d\xF2ng ch\u1EEF H\xE1n \"L\xE3o oa gi\u1EA3ng \u0111\u1ED9c\"  (C\xF3c gi\xE0
    d\u1EA1y h\u1ECDc). Trung t\xE2m b\u1EE9c tranh l\xE0 h\xECnh t\u01B0\u1EE3ng
    th\u1EA7y \u0111\u1ED3 c\xF3c t\xEDa b\u1EC7 v\u1EC7, oai nghi\xEAm ng\u1ED3i
    tr\xEAn s\u1EADp g\u1EE5 b\xEAn b\xE0n nghi\xEAn b\xFAt v\xE0 \u1EA5m tr\xE0;
    xung quanh l\xE0 l\u1EDBp h\u1ECDc sinh \u0111\u1ED9ng v\u1EDBi \u0111\u1EE7
    d\xE1ng v\u1EBB h\u1ECDc tr\xF2: c\xF3 ch\xFA kh\xE9p n\xE9p d\xE2ng n\u01B0\u1EDBc
    h\u1EA7u th\u1EA7y, ch\xFA c\u1EAFp tr\xE1p s\xE1ch ch\u0103m ch\u1EC9, l\u1EA1i
    c\xF3 nh\u1EEFng ch\xFA c\xF3c ng\u1ED7 ngh\u1ECBch \u0111\xF9a gi\u1EE1n, c\xF5ng
    nhau b\u1ECB qu\u1EA5t roi r\u0103n \u0111e. B\u1EE9c tranh v\u1EEBa t\xF4n vinh
    truy\u1EC1n th\u1ED1ng t\xF4n s\u01B0 tr\u1ECDng \u0111\u1EA1o v\xE0 tinh th\u1EA7n
    hi\u1EBFu h\u1ECDc ng\xE0n \u0111\u1EDDi, v\u1EEBa d\xED d\u1ECFm ph\xEA ph\xE1n
    s\u1EF1 khu\xF4n ph\xE9p, h\u1EE7 nho trong l\u1ED1i h\u1ECDc c\u1EED nghi\u1EC7p
    phong ki\u1EBFn x\u01B0a."
  paintingSprite: {fileID: 21300000, guid: 8a6d8880122abe247a28286d31ec1eb4, type: 3}
