  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "B\xE1t Ti\xEAn"
  paintingDescription: "B\u1ED9 tranh t\u1EE9 b\xECnh g\u1ED3m 4 b\u1EE9c kh\u1ED5
    \u0111\u1EE9ng kh\u1EAFc h\u1ECDa 8 v\u1ECB ti\xEAn huy\u1EC1n tho\u1EA1i trong
    \u0110\u1EA1o gi\xE1o \u0111ang ung dung \u0111\xE0m \u0111\u1EA1o, th\u01B0\u1EDFng
    ngo\u1EA1n non n\u01B0\u1EDBc d\u01B0\u1EDBi c\u1ED9i t\xF9ng, kh\xF3m tr\xFAc.
    M\u1ED7i v\u1ECB ti\xEAn c\u1EA7m m\u1ED9t ph\xE1p b\u1EA3o \u0111\u1EB7c tr\u01B0ng
    (b\u1EA7u h\u1ED3 l\xF4, qu\u1EA1t ba ti\xEAu, s\xE1o ng\u1ECDc, ki\u1EBFm b\xE1u...)
    t\u01B0\u1EE3ng tr\u01B0ng cho s\u1EF1 tr\u01B0\u1EDDng th\u1ECD, an l\xE0nh
    v\xE0 quy\u1EC1n n\u0103ng xua \u0111u\u1ED5i t\xE0 kh\xED. B\u1ED9 tranh th\u1EC3
    hi\u1EC7n \u01B0\u1EDBc nguy\u1EC7n v\u1EC1 cu\u1ED9c s\u1ED1ng si\xEAu nhi\xEAn
    thanh th\u1EA3n, ch\xFAc ph\xFAc th\u1ECD khang ninh cho gia \u0111\xECnh."
  paintingSprite: {fileID: 21300000, guid: f3fcccd22609bf7449dd00124775ffa2, type: 3}
