  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: VINH HOA
  paintingDescription: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa b\xE9 trai b\u1EE5 b\u1EABm,
    kh\xF4i ng\xF4 \xF4m ch\u1EB7t ch\xFA g\xE0 tr\u1ED1ng oai v\u1EC7 b\xEAn c\u1EA1nh
    c\xE0nh hoa c\xFAc r\u1EF1c r\u1EE1. Trong quan ni\u1EC7m d\xE2n gian, g\xE0
    tr\u1ED1ng (\u0111\u1EA1i k\xEA) \u0111\u1ED3ng \xE2m v\u1EDBi \"\u0111\u1EA1i
    c\xE1t\", \u0111\u1EA1i di\u1EC7n cho 5 \u0111\u1EE9c t\xEDnh: V\u0103n, V\xF5,
    D\u0169ng, Nh\xE2n, T\xEDn. Hoa c\xFAc bi\u1EC3u tr\u01B0ng cho s\u1EF1 tr\u01B0\u1EDDng
    th\u1ECD v\xE0 an l\xE0nh. B\u1EE9c tranh g\u1EEDi g\u1EAFm \u01B0\u1EDBc nguy\u1EC7n
    \u0111\u1EA7u xu\xE2n v\u1EC1 con \u0111\xE0n ch\xE1u \u0111\u1ED1ng, c\u1EA7u
    ch\xFAc sinh con trai kh\u1ECFe m\u1EA1nh, th\xF4ng minh, r\u1EA1ng danh d\xF2ng
    t\u1ED9c v\xE0 mang vinh hi\u1EC3n v\u1EC1 cho gia \u0111\xECnh."
  paintingSprite: {fileID: 21300000, guid: b56ea36b5c18d8d489878abcc7f3b618, type: 3}
