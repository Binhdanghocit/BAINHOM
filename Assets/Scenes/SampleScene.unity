  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "Truy\u1EC7n Th\u01A1 Th\u1EA1ch Sanh"
  paintingDescription: "B\u1ED9 tranh li\xEAn ho\xE0n 4 b\u1EE9c di\u1EC5n t\u1EA3
    c\xE1c h\u1ED3i k\u1ECBch t\xEDnh trong truy\u1EC7n th\u01A1 N\xF4m khuy\u1EBFt
    danh Th\u1EA1ch Sanh: t\u1EEB g\u1ED1c \u0111a luy\u1EC7n v\xF5, ch\xE9m Ch\u1EB1n
    tinh, gi\u01B0\u01A1ng cung b\u1EAFn \u0110\u1EA1i b\xE0ng c\u1EE9u c\xF4ng ch\xFAa,
    \u0111\u1EBFn kh\xFAc g\u1EA3y \u0111\xE0n th\u1EA7n minh oan trong ng\u1EE5c
    v\xE0 ni\xEAu c\u01A1m th\u1EA7n th\u1EBFt \u0111\xE3i h\xE0ng binh 18 n\u01B0\u1EDBc
    ch\u01B0 h\u1EA7u. T\xE1c ph\u1EA9m ng\u1EE3i ca v\u1EBB \u0111\u1EB9p d\u0169ng
    c\u1EA3m, t\u1EA5m l\xF2ng nh\xE2n h\u1EADu, tinh th\u1EA7n chu\u1ED9ng h\xF2a
    b\xECnh c\u1EE7a ng\u01B0\u1EDDi lao \u0111\u1ED9ng v\xE0 kh\u1EB3ng \u0111\u1ECBnh
    ch\xE2n l\xFD d\xE2n gian \"\u1EDF hi\u1EC1n g\u1EB7p l\xE0nh, \xE1c gi\u1EA3
    \xE1c b\xE1o\"."
  paintingSprite: {fileID: 21300000, guid: 229169b8212358f49b84766313f8581c, type: 3}
