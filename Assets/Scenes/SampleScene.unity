  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "B\xC0 TRI\u1EC6U C\u01AF\u1EE0I VOI"
  paintingDescription: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa n\u1EEF anh h\xF9ng Tri\u1EC7u
    Th\u1ECB Trinh uy phong l\u1EABm li\u1EC7t, d\u1EA3i l\u1EE5a bay ph\u1EA5p ph\u1EDBi
    tr\xEAn l\u01B0ng voi tr\u1EAFng x\xF4ng pha tr\u1EADn m\u1EA1c. T\xE1c ph\u1EA9m
    t\xF4n vinh kh\xED ph\xE1ch ki\xEAn c\u01B0\u1EDDng, b\u1EA5t khu\u1EA5t c\u1EE7a
    ph\u1EE5 n\u1EEF Vi\u1EC7t Nam c\xF9ng l\u1EDDi th\u1EC1 non n\u01B0\u1EDBc:
    \"T\xF4i mu\u1ED1n c\u01B0\u1EE1i c\u01A1n gi\xF3 m\u1EA1nh, \u0111\u1EA1p lu\u1ED3ng
    s\xF3ng d\u1EEF, ch\xE9m c\xE1 k\xECnh \u1EDF bi\u1EC3n \u0110\xF4ng, ch\u1EE9
    kh\xF4ng th\xE8m b\u1EAFt ch\u01B0\u1EDBc ng\u01B0\u1EDDi \u0111\u1EDDi c\xFAi
    \u0111\u1EA7u l\xE0m t\xEC thi\u1EBFp\"."
  paintingSprite: {fileID: 21300000, guid: 58aed41d1a84b1d449742f1e7b438d66, type: 3}
