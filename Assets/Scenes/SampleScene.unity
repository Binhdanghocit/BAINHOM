  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "L\xDD NG\u01AF V\u1ECCNG NGUY\u1EC6T"
  paintingDescription: "Kh\u1EAFc h\u1ECDa ch\xFA c\xE1 ch\xE9p b\xE9o kh\u1ECFe
    u\u1ED1n l\u01B0\u1EE3n uy\u1EC3n chuy\u1EC3n ng\u1EAFm b\xF3ng tr\u0103ng tr\xF2n
    soi \u0111\xE1y n\u01B0\u1EDBc. C\xE1 ch\xE9p t\u01B0\u1EE3ng tr\u01B0ng cho
    \xFD ch\xED b\u1EC1n b\u1EC9 v\u01B0\u1EE3t v\u0169 m\xF4n h\xF3a r\u1ED3ng;
    b\xF3ng tr\u0103ng lung linh d\u01B0\u1EDBi n\u01B0\u1EDBc l\xE0 bi\u1EC3u t\u01B0\u1EE3ng
    cho s\u1EF1 h\u01B0 \u1EA3o c\u1EE7a cu\u1ED9c \u0111\u1EDDi. B\u1EE9c tranh
    mang tri\u1EBFt l\xFD nh\xE2n sinh s\xE2u s\u1EAFc: nh\u1EAFc nh\u1EDF ng\u01B0\u1EDDi
    \u0111\u1EDDi h\u01B0\u1EDBng \u0111\u1EBFn s\u1EF1 t\u0129nh t\xE2m, thanh khi\u1EBFt
    b\xEAn trong t\xE2m h\u1ED3n, kh\xF4ng m\u1EA3i m\xEA \u0111u\u1ED5i theo nh\u1EEFng
    \u1EA3o \u1EA3nh ph\xF9 hoa ngo\xE0i th\u1EBF t\u1EE5c."
  paintingSprite: {fileID: 21300000, guid: e973e357f28367b4ea2a2e7c799793e0, type: 3}
