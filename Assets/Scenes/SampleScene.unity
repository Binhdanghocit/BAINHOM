  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "\u0110\xC0N G\xC0 M\u1EB8 CON"
  paintingDescription: "Tranh mi\xEAu t\u1EA3 h\xECnh \u1EA3nh con g\xE0 m\xE1i m\u1EB9
    \u0111ang ng\u1EADm con ong, \u0111ang hi\u1EC1n t\u1EEB, ch\u0103m ch\xFAt c\xE1c
    con. 10 ch\xFA g\xE0 con \u0111\u1EE9ng quanh g\xE0 m\u1EB9 nh\u01B0ng \u0111\u1EC1u
    c\xF3 nh\u1EEFng n\xE9t chuy\u1EC3n \u0111\u1ED9ng kh\xE1c nhau: Con \u0111ang
    r\u1EC9a l\xF4ng, con \u0111\xF9a ch\u1EA1y, con n\u1EA5p d\u01B0\u1EDBi b\u1EE5ng
    g\xE0 m\u1EB9. Con l\u1EA1i tr\xE8o l\xEAn l\u01B0ng g\xE0 m\u1EB9"
  paintingSprite: {fileID: 21300000, guid: 1ecf7daca5743c742b223118158d0b48, type: 3}
