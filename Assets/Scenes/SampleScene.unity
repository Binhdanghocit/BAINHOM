  m_Script: {fileID: 11500000, guid: cc62df76ccbd8d64b9d9cc3bc7503437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "CHU\u1ED8T VINH QUY"
  paintingDescription: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa c\u1EA3nh Tr\u1EA1ng Chu\u1ED9t
    \u0111\u1ED7 \u0111\u1EA1t Ti\u1EBFn s\u0129 c\u01B0\u1EE1i ng\u1EF1a vinh quy
    b\xE1i t\u1ED5, k\u1EBFt h\u1EE3p nghi th\u1EE9c \"Ngh\xEAnh th\xEA l\u1EC5\"
    r\u01B0\u1EDBc d\xE2u v\u1EC1 l\xE0ng b\xEAn c\u1EA1nh l\xE1 c\u1EDD l\u1EDBn
    \u0111\u1EC1 ch\u1EEF \"Vinh Quy\". \u0110\u1EC3 \u0111o\xE0n r\u01B0\u1EDBc
    \u0111\u01B0\u1EE3c b\xECnh an \u0111i qua, h\u1ECD h\xE0ng nh\xE0 chu\u1ED9t
    ph\u1EA3i d\xE2ng c\xE1 ch\xE9p v\xE0 chim b\u1ED3 c\xE2u c\u1ED1ng n\u1EA1p
    cho ch\xFA m\xE8o gi\xE0 \u0111ang ng\u1ED3i ph\u1EE7 ph\u1EE5c. T\xE1c ph\u1EA9m
    t\xF4n vinh tinh th\u1EA7n hi\u1EBFu h\u1ECDc, \u01B0\u1EDBc m\u01A1 \u0111\u1ED7
    \u0111\u1EA1t c\u1EE7a k\u1EBB s\u0129 x\u01B0a, \u0111\u1ED3ng th\u1EDDi ph\u1EA3n
    \xE1nh tri\u1EBFt l\xFD x\u1EED th\u1EBF m\u1EC1m d\u1EBBo, th\u1EF1c t\u1EBF
    c\u1EE7a ng\u01B0\u1EDDi b\xECnh d\xE2n tr\u01B0\u1EDBc t\u1EA7ng l\u1EDBp cai
    tr\u1ECB."
  paintingSprite: {fileID: 21300000, guid: 3c9c063c2c3884a4a990a0e83d6ccb70, type: 3}
