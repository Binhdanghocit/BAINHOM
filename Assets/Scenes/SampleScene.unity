  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "TI\u1EBEN L\u1ED8C"
  paintingDescription: "V\u1ECB quan tay n\xE2ng cu\u1ED1n th\u01B0 \"Ti\u1EBFn L\u1ED9c\"
    v\xE0 g\u1EADy nh\u01B0 \xFD c\xE1t t\u01B0\u1EDDng, b\xEAn c\u1EA1nh \u0111\u1EC1
    d\xF2ng ch\u1EEF \"L\u1ED9c v\u1ECB cao th\u0103ng\" (Ch\u1EE9c v\u1EE5 b\u1ED5ng
    l\u1ED9c ng\xE0y m\u1ED9t th\u0103ng ti\u1EBFn). \u0110i li\u1EC1n c\xF9ng tranh
    Ti\u1EBFn T\xE0i b\xEAn c\xE1nh c\u1EEDa \u0111\u1ED1i di\u1EC7n, b\u1EE9c tranh
    l\xE0 l\u1EDDi ch\xFAc \u0111\u1EA7u xu\xE2n v\u1EC1 \u0111\u01B0\u1EDDng c\xF4ng
    danh r\u1EA1ng r\u1EE1, h\u1ECDc h\xE0nh \u0111\u1ED7 \u0111\u1EA1t, gia \u0111\xECnh
    nh\u1EADn nhi\u1EC1u \u01A1n ph\u01B0\u1EDBc an khang."
  paintingSprite: {fileID: 21300000, guid: c9655d4fccd3387429957462cdfc1224, type: 3}
