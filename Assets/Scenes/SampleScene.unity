  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaintingInfo
  paintingTitle: "\u0110\xC1M C\u01AF\u1EDAI CHU\u1ED8T"
  paintingDescription: "B\u1EA3n kh\u1EAFc g\u1ED7 c\u1ED5 truy\u1EC1n v\u1EDBi n\xE9t
    \u0111\u1EE5c th\xF4 m\u1ED9c, t\xE1i hi\u1EC7n tr\u1ECDn v\u1EB9n kh\xF4ng kh\xED
    \u0111\xE1m c\u01B0\u1EDBi th\xF4n d\xE3 v\u1EDBi ki\u1EC7u hoa, k\xE8n th\u1ED5i,
    tr\u1ED1ng g\xF5 r\u1ED9n r\xE0ng c\u1EE7a h\u1ECD nh\xE0 chu\u1ED9t. T\u1EA7ng
    tr\xEAn l\xE0 c\u1EA3nh chu\u1ED9t k\xEDnh c\u1EA9n d\xE2ng l\u1EC5 v\u1EADt
    \u0111\u1EC3 xin \u0111\u01B0\u1EDDng m\xE8o gi\xE0 hung d\u1EEF. B\u1EE9c tranh
    tr\xE0o ph\xFAng \u0111\u1EC9nh cao c\u1EE7a ngh\u1EC7 thu\u1EADt d\xE2n gian
    Vi\u1EC7t Nam, v\u1EEBa ch\xE2m bi\u1EBFm s\xE2u cay t\u1EC7 n\u1EA1n s\xE1ch
    nhi\u1EC5u c\u1EE7a c\u01B0\u1EDDng h\xE0o \xE1c b\xE1, v\u1EEBa kh\u1EB3ng \u0111\u1ECBnh
    tinh th\u1EA7n l\u1EA1c quan, kh\xE1t v\u1ECDng h\xF2a b\xECnh v\xE0 cu\u1ED9c
    s\u1ED1ng y\xEAn l\xE0nh c\u1EE7a ng\u01B0\u1EDDi n\xF4ng d\xE2n."
  paintingSprite: {fileID: 21300000, guid: 994db91811efe6b41b2988cee27dfc28, type: 3}
